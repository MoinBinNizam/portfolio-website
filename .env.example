# Backend Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
CORS_ORIGIN=http://localhost:5173

# Initial Owner Account (used by `pnpm --filter ./backend create-owner`)
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-strong-password

# Cloudinary Media Uploads (optional in dev; falls back to local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail / SMTP Contact Notifications & Admin Replies
# For Gmail, enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
CONTACT_TO_EMAIL=your-gmail@gmail.com
